# ===========================================
# AI Math Grader - Environment Variables
# ===========================================
# Copy this file to .env and add your API key:
#   cp env.example .env
# ===========================================

# ===========================================
# LLM PROVIDER CONFIGURATION
# Choose ONE provider and add your API key
# ===========================================

# Option 1: OpenAI (Recommended)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Option 2: Anthropic (Claude)
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option 3: Google (Gemini)
# Get your key at: https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key-here
# GOOGLE_MODEL=gemini-1.5-pro

# Option 4: Groq (Fast & Free tier available)
# Get your key at: https://console.groq.com/keys
# GROQ_API_KEY=gsk-your-groq-key-here
# GROQ_MODEL=llama-3.1-70b-versatile

# ===========================================
# PROVIDER SELECTION
# Uncomment the provider you want to use
# ===========================================
LLM_PROVIDER=openai
# LLM_PROVIDER=anthropic
# LLM_PROVIDER=google
# LLM_PROVIDER=groq
